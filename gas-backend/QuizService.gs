  function getMySeasonStats(token,input){var auth=requireStudent_(token),season=resolveSeason_(input&&input.seasonId,true),completed=userSeasonSessions_(auth.user.UserID,season.SeasonID).filter(function(row){return row.Status==='COMPLETED';}),correct=completed.reduce(function(sum,row){return sum+Number(row.Correct||0);},0),average=completed.length?Math.round(completed.reduce(function(sum,row){return sum+Number(row.Score||0);},0)/completed.length):0;return successResponse({seasonId:season.SeasonID,seasonPoint:PointService.getSeasonPoint(auth.user.UserID,season.SeasonID),totalPoint:Number(DatabaseService.findById('Users','UserID',auth.user.UserID).TotalPointCache||0),quizCompleted:completed.length,correctAnswers:correct,averageScore:average},'Statistik season berhasil dimuat.');}

  function finalize_(quiz,season,userId){return finalizeWithAnswers_(quiz,season,userId,validAnswers_(quiz.SessionID));}
  function finalizeWithAnswers_(quiz,season,userId,answers){var questions=parseQuestionIds_(quiz),correct=answers.filter(function(row){return isTrue_(row.IsCorrect);}).length,wrong=questions.length-correct,score=questions.length?Math.round(correct/questions.length*100):0,quizPoint=answers.reduce(function(sum,row){return sum+Number(row.Point||0);},0),bonus=correct===questions.length?Number(getSetting_('PERFECT_SCORE_BONUS',0)):0,finished=nowIso_(),duration=Math.max(0,Math.round((new Date(finished).getTime()-new Date(quiz.StartedAt).getTime())/1000)),total=quizPoint+bonus;DatabaseService.updateById('QuizSessions','SessionID',quiz.SessionID,{FinishedAt:finished,Correct:correct,Wrong:wrong,Score:score,Bonus:bonus,TotalPoint:total,Duration:duration,Status:'COMPLETED',UpdatedAt:finished});quiz=DatabaseService.findById('QuizSessions','SessionID',quiz.SessionID);var totalPoint=PointService.awardQuiz(userId,season,quiz,quizPoint,bonus);logActivity_(userId,'FINISH_QUIZ','QuizSession',quiz.SessionID,'Menyelesaikan challenge','');return resultPayload_(quiz,userId,totalPoint);}
