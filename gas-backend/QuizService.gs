  function optionMap_(sessionId,question){var secret=quizOptionSecret_();return['A','B','C','D'].map(function(letter){return{letter:letter,id:'opt_'+sha256Hex_(secret+'|id|'+sessionId+'|'+question.QuestionID+'|'+letter).slice(0,16),text:String(question['Option'+letter]||''),order:sha256Hex_(secret+'|order|'+sessionId+'|'+question.QuestionID+'|'+letter)};}).sort(function(a,b){return a.order.localeCompare(b.order);});}
