  function finish(token,input){return DatabaseService.withLock(function(){var auth=requireStudent_(token),quiz=ownedQuiz_(auth.user.UserID,input&&input.quizSessionId),season=resolveSeason_(quiz.SeasonID,false);if(quiz.Status==='COMPLETED'){var reconciled=ensureCompletedAward_(quiz,season,auth.user.UserID);return successResponse(resultPayload_(quiz,auth.user.UserID,reconciled),'Hasil quiz berhasil dimuat.');}ensureStarted_(quiz,season);if(validAnswers_(quiz.SessionID).length!==parseQuestionIds_(quiz).length)throw new AppError('Masih ada pertanyaan yang belum dijawab.','QUIZ_NOT_AVAILABLE');return successResponse(finalize_(quiz,season,auth.user.UserID),'Challenge selesai.');});}
