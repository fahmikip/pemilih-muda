  function resultPayload_(quiz,userId,totalPoint){return{quizSessionId:quiz.SessionID,seasonId:quiz.SeasonID,correct:Number(quiz.Correct),wrong:Number(quiz.Wrong),score:Number(quiz.Score),bonus:Number(quiz.Bonus),point:Number(quiz.TotalPoint),duration:Number(quiz.Duration),totalPoint:totalPoint===undefined?Number(DatabaseService.findById('Users','UserID',userId).TotalPointCache||0):totalPoint};}
  function sessionPayload_(quiz,season,userId){var question=currentQuestion_(quiz),answered=validAnswers_(quiz.SessionID).length,total=parseQuestionIds_(quiz).length,remaining=remainingSeconds_(quiz,season);return{quizSessionId:quiz.SessionID,season:{SeasonID:season.SeasonID,Name:season.Name,Theme:season.Theme,QuizDuration:Number(season.QuizDuration||0),ShowExplanation:toBoolean_(season.ShowExplanation)},attempt:Number(quiz.Attempt),answered:answered,totalQuestions:total,remainingSeconds:remaining,question:question?publicQuestion_(quiz.SessionID,question,answered,total):null};}
  function currentQuestion_(quiz){var answered={};validAnswers_(quiz.SessionID).forEach(function(row){answered[row.QuestionID]=true;});var id=parseQuestionIds_(quiz).filter(function(questionId){return !answered[questionId];})[0];return id?getQuestionByIdFast_(id):null;}
