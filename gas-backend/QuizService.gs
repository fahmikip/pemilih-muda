  function submitAnswer(token,input){var perf=performanceTimer_('submitAnswer'),auth=requireStudentFast_(token);perf.mark('validateSession');var quiz=ownedQuiz_(auth.user.UserID,input&&input.quizSessionId),season=resolveSeason_(quiz.SeasonID,false),questionId=sanitizeText_(input&&input.questionId,40,'QuestionID'),snapshot=parseQuestionIds_(quiz);perf.mark('loadQuizSession');if(snapshot.indexOf(questionId)<0)throw new AppError('Pertanyaan bukan bagian dari session.','QUESTION_NOT_IN_SESSION');var question=getQuestionByIdFast_(questionId);if(!question)throw new AppError('Pertanyaan tidak ditemukan.','QUESTION_NOT_FOUND');var selected=resolveOption_(quiz.SessionID,question,input&&input.selectedOption);if(!selected)throw new AppError('Pilihan jawaban tidak valid.','INVALID_OPTION');var correct=selected.letter===String(question.CorrectAnswer).toUpperCase(),point=correct?Number(question.Point||season.PointPerQuestion||0):0;perf.mark('loadQuestion');var outcome=DatabaseService.withLock(function(){DatabaseService.refreshRows('QuizSessions');quiz=ownedQuiz_(auth.user.UserID,quiz.SessionID);ensureStarted_(quiz,season);var answers=DatabaseService.refreshRows('QuizAnswers').filter(function(row){return row.SessionID===quiz.SessionID&&row.Status==='VALID';}),answeredSet={};answers.forEach(function(row){answeredSet[row.QuestionID]=true;});if(answeredSet[questionId])throw new AppError('Pertanyaan sudah dijawab.','QUESTION_ALREADY_ANSWERED');var now=nowIso_(),lastAt=answers.length?answers[answers.length-1].AnsweredAt:quiz.StartedAt,responseTime=Math.max(0,new Date(now).getTime()-new Date(lastAt).getTime()),answer={AnswerID:generateId('ANS'),SessionID:quiz.SessionID,UserID:auth.user.UserID,QuestionID:questionId,SelectedAnswer:selected.letter,IsCorrect:correct,Point:point,AnsweredAt:now,ResponseTimeMs:responseTime,Status:'VALID'};DatabaseService.insert('QuizAnswers',answer);answers.push(answer);answeredSet[questionId]=true;var done=answers.length===snapshot.length,finalResult=done?fin