var AdminService=(function(){
  var roles=['ADMIN','SUPERADMIN'];
  function getUsers(token){requireRole(token,roles);var rows=DatabaseService.getAllRows('Users').map(function(u){return{UserID:u.UserID,Name:u.Name,NIS:u.NIS,SchoolID:u.SchoolID,Class:u.Class,BirthDate:u.BirthDate,WhatsApp:u.WhatsApp,Email:u.Email,Role:u.Role,Status:u.Status,TotalPointCache:Number(u.TotalPointCache||0),FraudScore:Number(u.FraudScore||0),CreatedAt:u.CreatedAt,UpdatedAt:u.UpdatedAt,LastLogin:u.LastLogin};});return successResponse(rows,'Data pengguna berhasil dimuat.');}
  function getSchools(token){requireRole(token,roles);return successResponse(DatabaseService.getAllRows('Schools'),'Data sekolah berhasil dimuat.');}
  function createSchool(token,input){var auth=requireRole(token,roles);input=input||{};return DatabaseService.withLock(function(){var name=rejectFormula_(input.schoolName,160,'Nama sekolah');var npsn=sanitizeText_(input.npsn,20,'NPSN');var type=sanitizeText_(input.type,30,'Jenis sekolah');var address=rejectFormula_(input.address||'',500,'Alamat');var district=rejectFormula_(input.district||'',120,'Kecamatan');ValidationService.validateRequired(name,'Nama sekolah');ValidationService.validateRequired(npsn,'NPSN');if(!/^\d{8}$/.test(npsn))throw new AppError('NPSN harus 8 digit.','VALIDATION_ERROR');if(DatabaseService.exists('Schools','NPSN',npsn))throw new AppError('NPSN sudah tersedia.','VALIDATION_ERROR');var now=nowIso_(),row={SchoolID:generateId('SCH'),SchoolName:name,NPSN:npsn,Type:type,Address:address,District:district,Status:'ACTIVE',CreatedAt:now,UpdatedAt:now};DatabaseService.insert('Schools',row);logActivity_(auth.user.UserID,'CREATE','School',row.SchoolID,'Membuat sekolah', '');return successResponse(row,'Sekolah berhasil dibuat.');});}
  function updateSchool(token,input){var auth=requireRole(token,roles);input=input||{};var id=sanitizeText_(input.schoolId,40,'SchoolID');var current=DatabaseService.findById('Schools','SchoolID',id);if(!current)throw new AppError('Sekolah tidak ditemukan.','SCHOOL_NOT_FOUND');var changes={UpdatedAt:nowIso_()};if(input.schoolName!==undefined)changes.SchoolName=rejectFormula_(input.schoolName,160,'Nama sekolah');if(input.type!==undefined)changes.Type=sanitizeText_(input.type,30,'Jenis sekolah');if(input.address!==undefined)changes.Address=rejectFormula_(input.address,500,'Alamat');if(input.district!==undefined)changes.District=rejectFormula_(input.district,120,'Kecamatan');DatabaseService.updateById('Schools','SchoolID',id,changes);logActivity_(auth.user.UserID,'UPDATE','School',id,'Memperbarui sekolah','');return successResponse({SchoolID:id},'Sekolah berhasil diperbarui.');}
  function disableSchool(token,input){var auth=requireRole(token,roles);var id=sanitizeText_((input||{}).schoolId,40,'SchoolID');if(!DatabaseService.findById('Schools','SchoolID',id))throw new AppError('Sekolah tidak ditemukan.','SCHOOL_NOT_FOUND');DatabaseService.updateById('Schools','SchoolID',id,{Status:'INACTIVE',UpdatedAt:nowIso_()});logActivity_(auth.user.UserID,'DISABLE','School',id,'Menonaktifkan sekolah','');return successResponse({SchoolID:id},'Sekolah dinonaktifkan.');}
  function createSeason(token,input){var auth=requireRole(token,roles);input=input||{};var name=rejectFormula_(input.name,160,'Nama season'),status=sanitizeText_(input.status||'DRAFT',20,'Status');ValidationService.validateRequired(name,'Nama season');ValidationService.validateDate(input.startDate,'Tanggal mulai');ValidationService.validateDate(input.endDate,'Tanggal selesai');ValidationService.validateEnum(status,DATABASE_ENUMS.SeasonStatus,'Status season');if(new Date(input.endDate)<new Date(input.startDate))throw new AppError('Tanggal selesai harus setelah tanggal mulai.','VALIDATION_ERROR');var now=nowIso_(),row={SeasonID:generateId('SEA'),Name:name,Theme:rejectFormula_(input.theme||'',160,'Tema'),Description:rejectFormula_(input.description||'',2000,'Deskripsi'),StartDate:sanitizeText_(input.startDate,30,'Tanggal mulai'),EndDate:sanitizeText_(input.endDate,30,'Tanggal selesai'),Status:status,Reward:rejectFormula_(input.reward||'',200,'Reward'),QuestionCount:positiveInt_(input.questionCount,25,'QuestionCount'),PointPerQuestion:positiveInt_(input.pointPerQuestion,getSetting_('DEFAULT_QUESTION_POINT',10),'PointPerQuestion'),MaxAttempt:positiveInt_(input.maxAttempt,getSetting_('QUIZ_MAX_ATTEMPT',1),'MaxAttempt'),QuizDuration:positiveInt_(input.quizDuration,getSetting_('QUIZ_TIME_LIMIT',1800),'QuizDuration'),ShowExplanation:input.showExplanation!==false,CreatedAt:now,UpdatedAt:now};DatabaseService.insert('Seasons',row);logActivity_(auth.user.UserID,'CREATE','Season',row.SeasonID,'Membuat season','');return successResponse(row,'Season berhasil dibuat.');}
  function createQuestion(token,input){var auth=requireRole(token,roles);input=input||{};var correct=sanitizeText_(input.correctAnswer,1,'Jawaban benar').toUpperCase(),difficulty=sanitizeText_(input.difficulty||'MEDIUM',10,'Kesulitan'),status=sanitizeText_(input.status||'ACTIVE',10,'Status');ValidationService.validateEnum(correct,['A','B','C','D'],'Jawaban benar');ValidationService.validateEnum(difficulty,DATABASE_ENUMS.Difficulty,'Kesulitan');ValidationService.validateEnum(status,DATABASE_ENUMS.QuestionStatus,'Status');var now=nowIso_(),row={QuestionID:generateId('QUE'),Category:rejectFormula_(input.category,100,'Kategori'),Question:rejectFormula_(input.question,2000,'Pertanyaan'),OptionA:rejectFormula_(input.optionA,500,'Option A'),OptionB:rejectFormula_(input.optionB,500,'Option B'),OptionC:rejectFormula_(input.optionC,500,'Option C'),OptionD:rejectFormula_(input.optionD,500,'Option D'),CorrectAnswer:correct,Explanation:rejectFormula_(input.explanation||'',3000,'Pembahasan'),Difficulty:difficulty,Point:positiveInt_(input.point,getSetting_('DEFAULT_QUESTION_POINT',10),'Point'),Status:status,CreatedAt:now,UpdatedAt:now};['Category','Question','OptionA','OptionB','OptionC','OptionD'].forEach(function(f){ValidationService.validateRequired(row[f],f);});DatabaseService.insert('Questions',row);invalidateQuestionCache_();logActivity_(auth.user.UserID,'CREATE','Question',row.QuestionID,'Membuat soal','');return successResponse({QuestionID:row.QuestionID,Category:row.Category,Question:row.Question,Difficulty:row.Difficulty,Point:row.Point,Status:row.Status},'Soal berhasil dibuat.');}
  function positiveInt_(value,fallback,field){var number=value===undefined||value===''?Number(fallback):Number(value);if(!Number.isInteger(number)||number<=0)throw new AppError(field+' harus bilangan bulat positif.','VALIDATION_ERROR');return number;}
  return Object.freeze({getUsers:getUsers,getSchools:getSchools,createSchool:createSchool,updateSchool:updateSchool,disableSchool:disableSchool,createSeason:createSeason,createQuestion:createQuestion});
})();
